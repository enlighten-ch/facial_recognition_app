<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#995B3F8C" /><corners android:radius="28dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#F25B3F8C" /><corners android:radius="28dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#C75B3F8C" /><stroke android:width="1.5dp" android:color="#59FFFFFF" /><corners android:radius="28dp" /></shape>
    </item>
</selector>
