<?xml version="1.0" encoding="utf-8"?>
<!--
  Two presentations of the same pages (ViewFlipper "pageFlipper") and camera panel:
  - developerRoot: status rows, camera on the left, pages on the right
  - operationRoot: full-screen camera with the guide and floating buttons (normal kiosk use)
  KioskScreen moves the camera panel between the two; OperationScreen draws the operation screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kioskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/developerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F7FB"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="얼굴 인식"
                    android:textColor="#111111"
                    android:textSize="@dimen/title_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:textSize="@dimen/subtitle_text" />
            </LinearLayout>

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/status_button_height"
                android:layout_marginStart="8dp"
                android:text="처음으로" />

            <Button
                android:id="@+id/logButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/status_button_height"
                android:layout_marginStart="8dp"
                android:text="로그" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/status_button_height"
                android:layout_marginStart="8dp"
                android:text="설정" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="서버"
                android:textColor="#1A3D8F"
                android:textSize="@dimen/status_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:textSize="@dimen/status_text" />

            <Button
                android:id="@+id/syncNowButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/status_button_height"
                android:layout_marginStart="8dp"
                android:text="지금 동기화" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로컬 DB"
                android:textColor="#1A3D8F"
                android:textSize="@dimen/status_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dbStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="@dimen/status_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="출력"
                android:textColor="#1A3D8F"
                android:textSize="@dimen/status_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/printStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:textSize="@dimen/status_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cameraPreviewPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:padding="12dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.allstar.faithid.kiosk.camera.GuideOverlayView
                    android:id="@+id/guideOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/developerPageHost"
                android:layout_width="@dimen/page_width"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:padding="16dp">

                <ViewFlipper
                    android:id="@+id/pageFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Page 0: monitor -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/monitorStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#111111"
                                android:textSize="@dimen/monitor_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/monitorDetailText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="#666666"
                                android:textSize="@dimen/detail_text" />

                            <Button
                                android:id="@+id/registerStartButton"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/action_button_height"
                                android:layout_marginTop="14dp"
                                android:text="등록 시작하기"
                                android:textSize="18sp"
                                android:visibility="gone" />

                            <Button
                                android:id="@+id/labelOnlyPrintButton"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/action_button_height"
                                android:layout_marginTop="10dp"
                                android:text="이름표만 출력하기"
                                android:textSize="18sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/candidateContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical" />

                            <Button
                                android:id="@+id/printButton"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/print_button_height"
                                android:layout_marginTop="14dp"
                                android:enabled="false"
                                android:text="이름표 출력하기"
                                android:textSize="@dimen/print_button_text"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>
                    </ScrollView>

                    <!-- Page 1: registration capture -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/registerStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#111111"
                            android:textSize="@dimen/monitor_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/registerDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="#666666"
                            android:textSize="@dimen/detail_text" />

                        <ProgressBar
                            android:id="@+id/registerProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginTop="12dp"
                            android:max="12" />

                        <TextView
                            android:id="@+id/registerCountText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:textColor="#111111"
                            android:textSize="@dimen/register_progress_text"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/duplicateIsMeButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/action_button_height"
                            android:layout_marginTop="14dp"
                            android:text="본인이 맞아요"
                            android:textSize="18sp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/duplicateNotMeButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/action_button_height"
                            android:layout_marginTop="10dp"
                            android:text="처음 등록이에요"
                            android:textSize="18sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Page 2: name, department, grade -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/infoTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#111111"
                                android:textSize="@dimen/monitor_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/infoDetailText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#B8322A"
                                android:textSize="@dimen/detail_text" />

                            <EditText
                                android:id="@+id/nameInput"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="12dp"
                                android:hint="이름"
                                android:importantForAutofill="no"
                                android:inputType="textPersonName"
                                android:singleLine="true"
                                android:textSize="20sp" />

                            <EditText
                                android:id="@+id/departmentInput"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="10dp"
                                android:hint="부서"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textSize="20sp" />

                            <EditText
                                android:id="@+id/gradeInput"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="10dp"
                                android:hint="학년"
                                android:importantForAutofill="no"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textSize="20sp" />

                            <Button
                                android:id="@+id/submitInfoButton"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/action_button_height"
                                android:layout_marginTop="14dp"
                                android:text="저장하기"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </ScrollView>

                    <!-- Page 3: output -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/outputNameText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#111111"
                                android:textSize="@dimen/output_name_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/outputDepartmentText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:textColor="#1A3D8F"
                                android:textSize="@dimen/output_sub_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/outputGradeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:textColor="#24633D"
                                android:textSize="@dimen/output_sub_text"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/outputStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:textColor="#666666"
                            android:textSize="@dimen/detail_text" />
                    </LinearLayout>
                </ViewFlipper>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Operation screen (따뜻한 안내자): the camera fills the screen; the guide 빛이 talks from the
         top and the reply buttons float at the bottom as translucent glass. OperationScreen fills it. -->
    <FrameLayout
        android:id="@+id/operationRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/operationCameraHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.allstar.faithid.kiosk.ui.guide.StarFieldView
            android:id="@+id/opStars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/operationOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/opPrivacy"
                style="@style/OverlayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:text="사진은 저장하지 않아요"
                android:textSize="15sp" />

            <!-- The 3D head that shows the move; OperationScreen lines its centre up with the circle. -->
            <LinearLayout
                android:id="@+id/opHeadCard"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/opHeadTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:textColor="#33263F"
                    android:textSize="22sp" />

                <com.allstar.faithid.kiosk.ui.guide.HeadView
                    android:id="@+id/opHead"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card" />

                <TextView
                    android:id="@+id/opHeadCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#6E6078"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/opCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="22dp"
                android:background="@drawable/bg_glass"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="#33263F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/opReplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="96dp"
                android:layout_marginBottom="44dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- The guide and the speech bubble. -->
            <LinearLayout
                android:id="@+id/opGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="90dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="90dp"
                android:gravity="top"
                android:orientation="horizontal">

                <com.allstar.faithid.kiosk.ui.guide.GuideAvatarView
                    android:id="@+id/opAvatar"
                    android:layout_width="76dp"
                    android:layout_height="76dp" />

                <LinearLayout
                    android:id="@+id/opBubble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bubble"
                    android:orientation="vertical"
                    android:paddingHorizontal="26dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/opTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:breakStrategy="balanced"
                        android:textColor="#33263F"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/opSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#6E6078"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/opBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="128dp"
                android:background="@drawable/bg_glass"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:textColor="#33263F"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Name form: the camera stays visible on the left. -->
            <LinearLayout
                android:id="@+id/opForm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.42" />

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.58"
                    android:background="@drawable/bg_warm_panel"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.allstar.faithid.kiosk.ui.guide.GuideAvatarView
                                android:layout_width="68dp"
                                android:layout_height="68dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:paddingHorizontal="24dp"
                                android:paddingVertical="14dp">

                                <TextView
                                    android:id="@+id/opFormTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="#33263F"
                                    android:textSize="28sp" />

                                <TextView
                                    android:id="@+id/opFormSub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="#6E6078"
                                    android:textSize="17sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="22dp">

                            <TextView
                                style="@style/FormLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/opNameInput"
                                android:text="이름" />

                            <EditText
                                android:id="@+id/opNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input"
                                android:hint="예: 김하은"
                                android:importantForAutofill="no"
                                android:inputType="textPersonName"
                                android:paddingHorizontal="20dp"
                                android:singleLine="true"
                                android:textColor="#33263F"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/FormLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="부서" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/opDepartmentChips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:singleSelection="true"
                                xmlns:app="http://schemas.android.com/apk/res-auto" />

                            <TextView
                                android:id="@+id/opGradeLabel"
                                style="@style/FormLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="학년 · 나이" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/opGradeChips"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:singleSelection="true"
                                xmlns:app="http://schemas.android.com/apk/res-auto" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/opDepartmentInput"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_input"
                                    android:hint="부서 직접 입력"
                                    android:importantForAutofill="no"
                                    android:inputType="text"
                                    android:paddingHorizontal="16dp"
                                    android:singleLine="true"
                                    android:textColor="#33263F"
                                    android:textSize="19sp" />

                                <EditText
                                    android:id="@+id/opGradeInput"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_input"
                                    android:hint="학년 직접 입력"
                                    android:imeOptions="actionDone"
                                    android:importantForAutofill="no"
                                    android:inputType="text"
                                    android:paddingHorizontal="16dp"
                                    android:singleLine="true"
                                    android:textColor="#33263F"
                                    android:textSize="19sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/opSubmitButton"
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_reply_main"
                            android:drawableStart="@drawable/ic_check"
                            android:drawablePadding="14dp"
                            android:gravity="center_vertical|start"
                            android:paddingHorizontal="30dp"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            app:backgroundTint="@null"
                            xmlns:app="http://schemas.android.com/apk/res-auto" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- Name tag: the label coming out of the printer, and the guide saying goodbye. -->
            <LinearLayout
                android:id="@+id/opOutput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_warm_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.46"
                    android:background="@drawable/bg_card"
                    android:clipChildren="true">

                    <View
                        android:id="@+id/opSlot"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_gravity="top"
                        android:layout_marginHorizontal="60dp"
                        android:layout_marginTop="64dp"
                        android:background="#33263F" />

                    <LinearLayout
                        android:id="@+id/opTag"
                        android:layout_width="380dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_card"
                        android:elevation="10dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/opTagStripe"
                            android:layout_width="20dp"
                            android:layout_height="match_parent"
                            android:background="#C9BCD2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="28dp">

                            <TextView
                                android:id="@+id/opTagName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autoSizeMaxTextSize="64sp"
                                android:autoSizeMinTextSize="24sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:textColor="#33263F"
                                android:textSize="64sp" />

                            <TextView
                                android:id="@+id/opTagSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#6E6078"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="32dp"
                    android:layout_weight="0.54"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.allstar.faithid.kiosk.ui.guide.GuideAvatarView
                            android:layout_width="80dp"
                            android:layout_height="80dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:paddingHorizontal="26dp"
                            android:paddingVertical="18dp">

                            <TextView
                                android:id="@+id/opOutputTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#33263F"
                                android:textSize="36sp" />

                            <TextView
                                android:id="@+id/opOutputSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="#6E6078"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/opOutputHome"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_reply"
                        android:paddingHorizontal="32dp"
                        android:text="처음으로"
                        android:textColor="#33263F"
                        android:textSize="22sp"
                        app:backgroundTint="@null"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/opHomeButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="top|start"
                android:layout_margin="18dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="처음으로"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_ink" />

            <ImageButton
                android:id="@+id/opSettingsButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="top|end"
                android:layout_margin="18dp"
                android:alpha="0.16"
                android:background="@android:color/transparent"
                android:contentDescription="설정 (길게 누르기)"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear_line" />
        </FrameLayout>

        <com.allstar.faithid.kiosk.ui.guide.CelebrationView
            android:id="@+id/opCelebration"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
