<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Title" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/jua</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Section" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Cell" parent="Text.Body">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
    <style name="Text.HeaderCell" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="Text.Muted" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="Text.Error" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/critical</item>
    </style>
    <style name="Text.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Chip" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <!-- Small rounded status label inside table rows ("✓ 출석", "아직"); tinted in code. -->
    <style name="Pill" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/bg_pill</item>
    </style>
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Soft" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_soft</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/critical</item>
        <item name="android:textColor">@color/critical</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.Dev" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#D9D0DD</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/dev_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Button.DevPrimary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="DevField" parent="Input">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
