<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Title" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Section" parent="">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Cell" parent="Text.Body">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingEnd">6dp</item>
    </style>
    <style name="Text.Muted" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="Text.Error" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/critical</item>
    </style>
    <style name="Text.Mono" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Chip" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>
