<?xml version="1.0" encoding="utf-8"?>
<!-- The row being edited, opened in place in the 명단 table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_edit_row"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/personNameInput"
            style="@style/DevField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:hint="@string/col_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/personDepartmentInput"
            style="@style/DevField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:hint="@string/col_department"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/personGradeInput"
            style="@style/DevField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:hint="@string/col_grade"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:id="@+id/personEditSamples"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/muted_soft"
            android:textColor="@color/ink_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/personSaveButton"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <Button
            android:id="@+id/personCloseButton"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/personDeleteButton"
            style="@style/Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_person" />
    </LinearLayout>
</LinearLayout>
