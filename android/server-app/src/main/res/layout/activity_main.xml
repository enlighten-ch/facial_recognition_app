<?xml version="1.0" encoding="utf-8"?>
<!-- Login, the dashboard (four tabs) and the developer screen, which covers the dashboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="@dimen/login_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title" />

        <TextView
            style="@style/Text.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitle" />

        <EditText
            android:id="@+id/loginIdInput"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:autofillHints="username"
            android:hint="@string/login_id"
            android:inputType="text" />

        <EditText
            android:id="@+id/loginPasswordInput"
            style="@style/Input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:autofillHints="password"
            android:hint="@string/login_password"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/loginMessageText"
            style="@style/Text.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/loginButton"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/login_button" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jua"
                android:text="@string/brand"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/serverStateChip"
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/state_stopped" />

            <TextView
                android:id="@+id/devScreenButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_dashed_underline"
                android:gravity="center"
                android:paddingHorizontal="2dp"
                android:text="@string/dev_screen"
                android:textColor="#8A7B94"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="@string/logout"
                android:textColor="#8A7B94"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tabs"
                android:orientation="horizontal"
                android:padding="4dp">
            <TextView
                android:id="@+id/tabToday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_today"
                android:textColor="@color/tab_text"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabPeople"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_people"
                android:textColor="@color/tab_text"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabAttendance"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_attendance"
                android:textColor="@color/tab_text"
                android:textSize="17sp"
                android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tabKiosks"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_kiosks"
                android:textColor="@color/tab_text"
                android:textSize="17sp"
                android:textStyle="bold" />

                    <View
                        android:id="@+id/kioskBadge"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/apricot"
                        android:contentDescription="@string/kiosk_waiting_badge"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <include layout="@layout/page_today" />

            <include layout="@layout/page_people" />

            <include layout="@layout/page_attendance" />

            <include layout="@layout/page_kiosks" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/page_dev" />
</FrameLayout>
