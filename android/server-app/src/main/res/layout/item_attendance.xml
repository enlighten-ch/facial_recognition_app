<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/attStatus"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/attInitial"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_dot"
            android:fontFamily="@font/jua"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/attName"
            style="@style/Text.Cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/attDepartmentDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/attGuest"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/guest_soft"
            android:text="@string/off_roster"
            android:textColor="@color/guest_ink" />

        <TextView
            android:id="@+id/attDepartment"
            style="@style/Text.Cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/attGrade"
        style="@style/Text.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2" />

    <TextView
        android:id="@+id/attFirst"
        style="@style/Text.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:fontFeatureSettings="tnum" />

    <TextView
        android:id="@+id/attKiosk"
        style="@style/Text.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8" />
</LinearLayout>
