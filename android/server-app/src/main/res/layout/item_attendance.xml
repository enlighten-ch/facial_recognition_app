<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView android:id="@+id/attName" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="@string/col_name" />
    <TextView android:id="@+id/attDepartment" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="@string/col_department" />
    <TextView android:id="@+id/attGrade" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="@string/col_grade" />
    <TextView android:id="@+id/attStatus" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="@string/col_status" />
    <TextView android:id="@+id/attFirst" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="@string/col_first" />
    <TextView android:id="@+id/attLast" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:text="@string/col_last" />
    <TextView android:id="@+id/attCount" style="@style/Text.Cell" android:layout_width="56dp" android:layout_height="wrap_content" android:text="@string/col_count" />
    <TextView android:id="@+id/attKiosk" style="@style/Text.Cell" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="@string/col_kiosk" />
</LinearLayout>
