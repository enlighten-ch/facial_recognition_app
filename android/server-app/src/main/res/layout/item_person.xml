<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/personInitial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_dot"
            android:fontFamily="@font/jua"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/personName"
            style="@style/Text.Cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/personDepartmentDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/personDepartment"
            style="@style/Text.Cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/personGrade"
        style="@style/Text.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4" />

    <TextView
        android:id="@+id/personSamples"
        style="@style/Text.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:fontFeatureSettings="tnum"
        android:gravity="end" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/personToday"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/personEditLabel"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="@string/edit_cell"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
