<?xml version="1.0" encoding="utf-8"?>
<!-- Developer screen: every server setting, the data folder, all kiosks and the whole log, plainly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devPage"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dev_paper"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_title"
            android:textColor="@color/dev_ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/devStateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/dev_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/devBackButton"
            style="@style/Button.Dev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_back" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dev_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:id="@+id/devNavStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_dev_nav"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/dev_status"
                android:textColor="@color/dev_nav_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/devNavSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_dev_nav"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/dev_settings"
                android:textColor="@color/dev_nav_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/devNavData"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_dev_nav"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/dev_data"
                android:textColor="@color/dev_nav_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/devNavKiosks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_dev_nav"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/dev_kiosks"
                android:textColor="@color/dev_nav_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/devNavLog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_dev_nav"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="@string/dev_log"
                android:textColor="@color/dev_nav_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dev_line" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/devStatusSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_status"
                    android:textColor="@color/dev_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/devStatusList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/devDataDirLine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/dev_ink"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                <Button
                    android:id="@+id/startButton"
                    style="@style/Button.DevPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="@string/start_server" />
                <Button
                    android:id="@+id/stopButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/stop_server" />
                <Button
                    android:id="@+id/quitButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/quit" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/devSettingsSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/dev_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_note"
                    android:textColor="@color/dev_muted"
                    android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_id"
                            android:textColor="@color/dev_ink"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/devAdminIdInput"
                        style="@style/DevField"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/port"
                            android:textColor="@color/dev_ink"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/port_hint"
                            android:textColor="@color/dev_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/devPortInput"
                        style="@style/DevField"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_dir"
                            android:textColor="@color/dev_ink"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_dir_hint"
                            android:textColor="@color/dev_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/devDataDirInput"
                        style="@style/DevField"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                <Button
                    android:id="@+id/devPickFolderButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/pick_folder" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/max_samples"
                            android:textColor="@color/dev_ink"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/max_samples_hint"
                            android:textColor="@color/dev_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/devMaxSamplesInput"
                        style="@style/DevField"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/devAutoStartSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:text="@string/auto_start"
                        android:textColor="@color/dev_ink"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                <Button
                    android:id="@+id/devPasswordButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="@string/change_password" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                <Button
                    android:id="@+id/devRevertButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/revert" />
                <Button
                    android:id="@+id/devSaveButton"
                    style="@style/Button.DevPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/save" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/config_file"
                        android:textColor="@color/dev_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                <TextView
                    android:id="@+id/devConfigPathText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/dev_muted"
                    android:textSize="13sp" />

                    <TextView
                        android:id="@+id/devConfigText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_code"
                        android:fontFamily="monospace"
                        android:padding="12dp"
                        android:textColor="@color/dev_ink"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/devDataSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/data_title"
                    android:textColor="@color/dev_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/devDataList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/devFileList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                <Button
                    android:id="@+id/importCsvButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="@string/import_csv" />
                <Button
                    android:id="@+id/exportCsvButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/export_csv" />
                <Button
                    android:id="@+id/reloadDbButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/reload_db" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">
                <Button
                    android:id="@+id/devSheetButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:text="@string/save_sheet" />
                <Button
                    android:id="@+id/devRangeButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/export_range" />
                    </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/reload_help"
                    android:textColor="@color/dev_muted"
                    android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/devKiosksSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_kiosks"
                    android:textColor="@color/dev_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/devClientTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/devLogSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_log"
                    android:textColor="@color/dev_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <TextView
                        android:id="@+id/logPathText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:textColor="@color/dev_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/devLogChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <EditText
                        android:id="@+id/devLogSearchInput"
                        style="@style/DevField"
                        android:layout_width="280dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:hint="@string/log_search"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/logText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/log_ink"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/devLogCountText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/dev_muted"
                        android:textSize="13sp" />
                <Button
                    android:id="@+id/devLogCopyButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/copy" />
                <Button
                    android:id="@+id/devLogClearButton"
                    style="@style/Button.Dev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/clear" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
