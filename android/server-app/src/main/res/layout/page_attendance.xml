<?xml version="1.0" encoding="utf-8"?>
<!-- 출석: department summary, filters and the day's attendance table. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendancePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/attendanceTitleText"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/attendanceSummaryText"
            style="@style/Text.Muted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/previousDayButton"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/previous_day" />
        <Button
            android:id="@+id/todayButton"
            style="@style/Button.Soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/today" />
        <Button
            android:id="@+id/nextDayButton"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/next_day" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/attendanceDepartmentSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/attendanceSearchInput"
            style="@style/Input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/attendance_search"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_tabs"
            android:orientation="horizontal"
            android:padding="3dp">
            <TextView
                android:id="@+id/showAllButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/show_all"
                android:textColor="@color/tab_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/showPresentButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/show_present"
                android:textColor="@color/tab_text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/showAbsentButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/show_absent"
                android:textColor="@color/tab_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button
            android:id="@+id/saveSheetButton"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/save_sheet" />
        <Button
            android:id="@+id/exportRangeButton"
            style="@style/Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/export_range" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_table_header"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">
        <TextView
            android:id="@+id/headAttStatus"
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_weight="1.3"
            android:layout_height="wrap_content"
            android:text="@string/col_status" />
        <TextView
            android:id="@+id/headAttName"
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_weight="2.2"
            android:layout_height="wrap_content"
            android:text="@string/col_name" />
        <TextView
            android:id="@+id/headAttDepartment"
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_weight="2.2"
            android:layout_height="wrap_content"
            android:text="@string/col_department" />

        <TextView
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:background="@null"
            android:text="@string/col_grade" />
        <TextView
            android:id="@+id/headAttTime"
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="@string/col_time" />
        <TextView
            android:id="@+id/headAttKiosk"
            style="@style/Text.HeaderCell"
            android:layout_width="0dp"
            android:layout_weight="1.8"
            android:layout_height="wrap_content"
            android:text="@string/col_kiosk" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/attendanceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_table_body"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/attendanceFooterText"
        style="@style/Text.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
</LinearLayout>
