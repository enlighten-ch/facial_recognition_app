<?xml version="1.0" encoding="utf-8"?>
<!-- Only the bottom edge shows: a quiet dashed underline for the "개발자 화면" link. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-2dp" android:right="-2dp" android:top="-2dp" android:bottom="12dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#CDBFD6" android:dashWidth="3dp" android:dashGap="3dp" />
        </shape>
    </item>
</layer-list>
